{
  "name": "@americana/maplibre-shield-generator",
  "description": "Generate highway shields for maplibre-gl-js maps",
  "version": "0.2.1",
  "author": "OpenStreetMap Americana Contributors",
  "type": "module",
  "keywords": [
    "americana",
    "highway",
    "shields",
    "shield",
    "generator",
    "maplibre",
    "maplibre-gl",
    "maplibre-gl-js"
  ],
  "license": "CC0-1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "source": "src/index.ts",
  "devDependencies": {
    "@types/color-rgba": "^2.1.0",
    "canvas": "^3.1.2",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.4",
    "shx": "^0.3.4",
    "tsx": "^4.6.2",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "chai": "^6.2.1",
    "@types/chai": "^5.2.3"
  },
  "scripts": {
    "code_format": "run-s code_format:prettier",
    "code_format:prettier": "prettier --write --list-different .",
    "clean": "shx rm -rf dist docs",
    "docs": "typedoc src/index.ts",
    "test": "mocha",
    "build:code": "node scripts/build.js",
    "build:types": "tsc -p tsconfig.declarations.json",
    "build": "run-s clean build:code build:types docs",
    "prepublishOnly": "npm run build",
    "preversion": "npm version --no-git-tag-version --preid alpha",
    "publish-alpha": "npm publish --access=public --tag alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osm-americana/maplibre-gl-shields.git"
  },
  "bugs": {
    "url": "https://github.com/osm-americana/maplibre-gl-shields/issues"
  },
  "homepage": "https://github.com/osm-americana/maplibre-gl-shields#readme",
  "dependencies": {
    "@types/node": "^22.19.19",
    "color-rgba": "^3.1.1",
    "maplibre-gl": "^6.16.0",
    "mocha": "^10.2.0"
  },
  "directories": {
    "test": "test"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless_graphics.d.ts",
      "import": "./dist/headless.js",
      "default": "./dist/headless.js"
    }
  },
  "peerDependencies": {
    "canvas": "^3.1.2"
  },
  "peerDependenciesMeta": {
    "canvas": {
      "optional": true
    }
  }
}
